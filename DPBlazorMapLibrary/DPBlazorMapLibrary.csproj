<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SignAssembly>False</SignAssembly>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageTags>blazor;map;leaflet;</PackageTags>
    <RepositoryUrl>https://github.com/ledpup/DPBlazorMap</RepositoryUrl>
    <Authors>Patrick Lea</Authors>
    <Description>DP Blaser Map is a library for Blazer, which is a wrapper on top of the Leaflet js library.</Description>
    <PackageProjectUrl>https://github.com/ledpup/DPBlazorMap</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>1.2.1</Version>
    <PackageId>LPBlazorMapLibrary</PackageId>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Models\Layers\RasterLayers\TileLayersWms\" />
    <Folder Include="Models\Layers\VectorLayers\SVGs\" />
    <Folder Include="Models\Layers\VectorLayers\SVGOverlays\" />
    <Folder Include="Models\Layers\VectorLayers\Canvases\" />
  </ItemGroup>

</Project>
